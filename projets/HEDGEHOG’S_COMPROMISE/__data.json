{"type":"data","nodes":[{"type":"data","data":[{"logo":1},{"createdAt":2,"updatedAt":3,"Logo":4},"2022-12-10T11:21:49.842Z","2023-07-21T12:06:33.099Z",{"data":5},{"id":6,"attributes":7},50,{"name":8,"alternativeText":9,"caption":9,"width":10,"height":11,"formats":12,"hash":32,"ext":14,"mime":17,"size":33,"url":34,"previewUrl":9,"provider":35,"provider_metadata":36,"createdAt":37,"updatedAt":37},"LOGO_KaPt_only.png",null,750,233,{"small":13,"thumbnail":24},{"ext":14,"url":15,"hash":16,"mime":17,"name":18,"path":9,"size":19,"width":20,"height":21,"provider_metadata":22},".png","https://res.cloudinary.com/dizcp5ddf/image/upload/v1689941180/small_LOGO_Ka_Pt_only_ab2158b9e3.png","small_LOGO_Ka_Pt_only_ab2158b9e3","image/png","small_LOGO_KaPt_only.png",25.96,500,155,{"public_id":16,"resource_type":23},"image",{"ext":14,"url":25,"hash":26,"mime":17,"name":27,"path":9,"size":28,"width":29,"height":30,"provider_metadata":31},"https://res.cloudinary.com/dizcp5ddf/image/upload/v1689941180/thumbnail_LOGO_Ka_Pt_only_ab2158b9e3.png","thumbnail_LOGO_Ka_Pt_only_ab2158b9e3","thumbnail_LOGO_KaPt_only.png",6.14,245,76,{"public_id":26,"resource_type":23},"LOGO_Ka_Pt_only_ab2158b9e3",20.1,"https://res.cloudinary.com/dizcp5ddf/image/upload/v1689941180/LOGO_Ka_Pt_only_ab2158b9e3.png","cloudinary",{"public_id":32,"resource_type":23},"2023-07-21T12:06:20.758Z"],"uses":{}},{"type":"data","data":[{"project":1},{"Nom":2,"Localisation":3,"Programme":4,"Surface":5,"Description":6,"createdAt":7,"updatedAt":8,"publishedAt":9,"locale":10,"Images":11,"localizations":231},"HEDGEHOG’S COMPROMISE","Viña Lanciano, Spain","Installation paysagère",40,"Né d’un dialogue entre deux archétypes de l’architecture — la cabane et la grotte — Le Compromis du Hérisso s’inscrit dans le paysage viticole de la Rioja comme un geste à la fois fragile et puissant. Suspendu entre refuge et belvédère, il épouse les ondulations des vignes, offre des échappées sur la boucle du fl euve Ebre et s’ancre avec légèreté au cœur de Viña Lanciano. Réalisé à partir de poutres de coffrage préfabriquées et de panneaux en bois Garnica, cet objet architectural célèbre l’élégance brute des matériaux simples. À l’image d’un Jenga monumental, son empilement joue des interstices et des ombres pour générer une expérience immersive, changeante selon la lumière, entre terre et ciel.À l’extérieur, l’ossature en cascade invite à l’ascension, offrant des vues cadrées sur le « León Dormido » et les montagnes lointaines. À l’intérieur, l’entrelacement de bois compose\nune grotte légère, un abri mi-clos où l’on peut se reposer, partager un pique-nique ou contempler le mouvement des saisons.\nLa structure devient un lieu de rencontre : un gradin pour un concert, un perchoir pour lire au soleil couchant, une alcôve ombragée pour goûter le vin et savourer la lenteur. Elle efface la frontière entre l’œuvre construite et le vivant, entre le regard humain et l’infi ni des paysages.","2025-09-23T17:34:31.663Z","2025-09-23T17:40:07.038Z","2025-09-23T17:40:06.594Z","fr-FR",{"data":12},[13,75,130,180],{"id":14,"attributes":15},128,{"name":16,"alternativeText":17,"caption":17,"width":18,"height":19,"formats":20,"hash":69,"ext":22,"mime":25,"size":70,"url":71,"previewUrl":17,"provider":72,"provider_metadata":73,"createdAt":74,"updatedAt":74},"interieur_202.Atmosphere_20copie-enhanced.png",null,4096,2304,{"large":21,"small":33,"medium":42,"xlarge":51,"thumbnail":60},{"ext":22,"url":23,"hash":24,"mime":25,"name":26,"path":17,"size":27,"width":28,"height":29,"sizeInBytes":30,"provider_metadata":31},".png","https://res.cloudinary.com/dizcp5ddf/image/upload/v1758648642/large_interieur_202_Atmosphere_20copie_enhanced_a71e01439a.png","large_interieur_202_Atmosphere_20copie_enhanced_a71e01439a","image/png","large_interieur_202.Atmosphere_20copie-enhanced.png",1251.38,1000,563,1251377,{"public_id":24,"resource_type":32},"image",{"ext":22,"url":34,"hash":35,"mime":25,"name":36,"path":17,"size":37,"width":38,"height":39,"sizeInBytes"
esource_type":32},{"ext":83,"url":168,"hash":169,"mime":86,"name":170,"path":17,"size":171,"width":172,"height":122,"sizeInBytes":173,"provider_metadata":174},"https://res.cloudinary.com/dizcp5ddf/image/upload/v1758648630/thumbnail_L1008977_copie_2_6bd83475c9.jpg","thumbnail_L1008977_copie_2_6bd83475c9","thumbnail_L1008977 copie 2.jpg",4.46,234,4458,{"public_id":169,"resource_type":32},"L1008977_copie_2_6bd83475c9",332.53,"https://res.cloudinary.com/dizcp5ddf/image/upload/v1758648631/L1008977_copie_2_6bd83475c9.jpg",{"public_id":175,"resource_type":32},"2025-09-23T17:30:31.720Z",{"id":181,"attributes":182},125,{"name":183,"alternativeText":17,"caption":17,"width":135,"height":184,"formats":185,"hash":226,"ext":83,"mime":86,"size":227,"url":228,"previewUrl":17,"provider":72,"provider_metadata":229,"createdAt":230,"updatedAt":230},"L1008987 copie.jpg",2394,{"large":186,"small":194,"medium":202,"xlarge":210,"thumbnail":218},{"ext":83,"url":187,"hash":188,"mime":86,"name":189,"path":17,"size":190,"width":191,"height":28,"sizeInBytes":192,"provider_metadata":193},"https://res.cloudinary.com/dizcp5ddf/image/upload/v1758648630/large_L1008987_copie_28750abb4d.jpg","large_L1008987_copie_28750abb4d","large_L1008987 copie.jpg",49.59,987,49587,{"public_id":188,"resource_type":32},{"ext":83,"url":195,"hash":196,"mime":86,"name":197,"path":17,"size":198,"width":199,"height":38,"sizeInBytes":200,"provider_metadata":201},"https://res.cloudinary.com/dizcp5ddf/image/upload/v1758648630/small_L1008987_copie_28750abb4d.jpg","small_L1008987_copie_28750abb4d","small_L1008987 copie.jpg",17.86,493,17864,{"public_id":196,"resource_type":32},{"ext":83,"url":203,"hash":204,"mime":86,"name":205,"path":17,"size":206,"width":207,"height":47,"sizeInBytes":208,"provider_metadata":209},"https://res.cloudinary.com/dizcp5ddf/image/upload/v1758648630/medium_L1008987_copie_28750abb4d.jpg","medium_L1008987_copie_28750abb4d","medium_L1008987 copie.jpg",32.39,740,32393,{"public_id":204,"resource_type":32},{"ext":83,"url":211,"hash":212,"mime":86,"name":213,"path":17,"size":214,"width":215,"height":56,"sizeInBytes":216,"provider_metadata":217},"https://res.cloudinary.com/dizcp5ddf/image/upload/v1758648630/xlarge_L1008987_copie_28750abb4d.jpg","xlarge_L1008987_copie_28750abb4d","xlarge_L1008987 copie.jpg",92.3,1480,92298,{"public_id":212,"resource_type":32},{"ext":83,"url":219,"hash":220,"mime":86,"name":221,"path":17,"size":222,"width":223,"height":122,"sizeInBytes":224,"provider_metadata":225},"https://res.cloudinary.com/dizcp5ddf/image/upload/v1758648630/thumbnail_L1008987_copie_28750abb4d.jpg","thumbnail_L1008987_copie_28750abb4d","thumbnail_L1008987 copie.jpg",3.22,154,3221,{"public_id":220,"resource_type":32},"L1008987_copie_28750abb4d",206.55,"https://res.cloudinary.com/dizcp5ddf/image/upload/v1758648630/L1008987_copie_28750abb4d.jpg",{"public_id":226,"resource_type":32},"2025-09-23T17:30:31.700Z",{"data":232},[233],{"id":234,"attributes":235},17,{"Nom":2,"Localisation":3,"Programme":236,"Surface":5,"Description":237,"createdAt":238,"updatedAt":239,"publishedAt":17,"locale":240},"Landscape installation ","Born from a dialogue between two archetypes of architecture — the hut and the cave — The Hedgehog’s Compromise takes its place in the wine-growing landscape of La Rioja as a gesture that is both fragile and powerful. Suspended between refuge and belvedere, it follows the undulations of the vineyards, offers glimpses of the Ebro River bend and anchors itself lightly at the heart of Viña Lanciano.\nMade from prefabricated formwork beams and wood panels, this architectural object celebrates the raw elegance of simple materials. Like a monumental Jenga, its stacking plays with interstices and shadows to create an immersive experience that changes with the light, poised between earth and sky.\nOutside, the cascading frame invites ascent, offering framed views towards the “León Dormido” and the distant mountains. Inside, the interlacing of timber forms a light cave, a semi-enclosed shelter in which to rest, share a picnic or contemplate the passing of the seasons. The structure becomes a meeting place: tiered seating for a concert, a perch for reading in the setting sun, a shaded alcove for tasting wine and savouring slowness. It erases the boundary between the built work and the living,between the human gaze and the infi nity of the landscape.","2025-09-23T17:35:21.889Z","2025-09-23T17:40:08.963Z","en"],"uses":{"params":["projectSlug"]}}]}
